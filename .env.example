# ==============================================================================
# CDC Media - Cấu hình Biến môi trường mẫu (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế trước khi khởi chạy
# ==============================================================================

# --- Môi trường & Cổng chạy ứng dụng ---
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL="https://media.ksbtdanang.vn"

# --- Cơ sở dữ liệu (PostgreSQL) ---
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/mediacdc?schema=public"

# --- Khóa bảo mật phiên đăng nhập (JWT Secret) ---
# Cần là một chuỗi ngẫu nhiên, độ dài tối thiểu 32 ký tự, tuyệt đối không chia sẻ công khai
JWT_SECRET="generate_a_random_secure_secret_key_at_least_32_chars_long"

# --- Đường dẫn thư mục lưu tệp cục bộ ---
UPLOADS_PATH="./uploads"

# --- Cấu hình Google Drive (Có thể cấu hình tại đây hoặc trong Admin Panel) ---
# GOOGLE_DRIVE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
# GOOGLE_DRIVE_CLIENT_SECRET="your_google_client_secret"
# GOOGLE_DRIVE_REFRESH_TOKEN="your_google_refresh_token"
# GOOGLE_DRIVE_FOLDER_ID="your_target_folder_id_on_google_drive"

# --- Cấu hình Google Gemini AI (Tự động đọc & tóm tắt tài liệu) ---
# Lấy miễn phí tại https://aistudio.google.com/
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
